{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "download",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "routes": [{
    "pattern": "download.starry.phd",
    "custom_domain": true
  }],
  "d1_databases": [{
    "binding": "STARRY_ID_DB",
    "database_name": "starry_id_db",
    "database_id": "01195c92-555e-4816-bddc-5b8cb2e795db"
  }],
  "send_email": [{
    "name": "REPORT_EMAIL",
    "destination_address": "yukidu@gmail.com"
  }],
  "containers": [{
    "name": "savevideo-videodownloader",
    "class_name": "VideoDownloader",
    "image": "./Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{"name": "DOWNLOADER", "class_name": "VideoDownloader"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["VideoDownloader"]}],
  "observability": {"enabled": false}
}
