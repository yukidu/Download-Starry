{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savevideo",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "routes": [{
    "pattern": "download.starry.phd",
    "custom_domain": true
  }],
  "containers": [{
    "class_name": "VideoDownloader",
    "image": "./Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{"name": "DOWNLOADER", "class_name": "VideoDownloader"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["VideoDownloader"]}],
  "observability": {"enabled": false}
}
